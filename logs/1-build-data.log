. *
. * Save data set
. *
. 
. keep subject_id task_order treatment event event_prob single_event switch sec
> onds_on_page fps first_row ///
>         mean_matching_single mean_matching_composite a b sex sex_male sex_fem
> ale sex_prefer_not_to_say agecat agecat_*

. order subject_id task_order treatment event event_prob single_event switch se
> conds_on_page fps first_row ///
>         mean_matching_single mean_matching_composite a b sex sex_male sex_fem
> ale sex_prefer_not_to_say agecat agecat_*

. sort subject_id task_order

. 
. save `datapath'/vbb_data, replace
(file data/vbb_data.dta not found)
file data/vbb_data.dta saved

. export delimited `datapath'/vbb_data.csv, replace
file data/vbb_data.csv saved

