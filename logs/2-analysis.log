. **# Online Appendix Table C.1: OLS regressions
. **********************************************
. 
. local controls i.agecat i.sex

. local controls_extended i.agecat i.sex task_minutes fps

. local standarderrors vce(robust)

. 
. program define display_treatment_p_values
  1.         local t_statistic = _b[2.treatment] / _se[2.treatment]
  2.         display "`e(depvar)'-index: VBB60 coefficient = " _b[2.treatment]
  3.         display "`e(depvar)'-index: two-sided p = " 2 * ttail(e(df_r), abs
> (`t_statistic'))
  4.         display "`e(depvar)'-index: one-sided p (VBB60 > VBB10) = " ttail(
> e(df_r), `t_statistic')
  5. end

