
. 
. local width 14.5cm

. local reps 2000

. 
. local treatment1fill fcolor(gs8%40) lcolor(gs8%40)

. local treatment2fill fcolor(none) lcolor(black) lwidth(medthin)

. local treatment1marker msymbol(O) mcolor(gs8%60) mlcolor(gs6%60)

. local treatment2marker msymbol(Sh) mcolor(black%70)

. local legendtreatments legend(order(1 "VBB10" 2 "VBB60"))

. 
. ************************************
. **# Load data and first manipulation
. ************************************
. 
. use `datapath'/vbb_data, clear

. 
. generate abs_error = abs(switch - event_prob)

. generate exact_report = abs_error == 2.5

. 
. bysort subject_id: egen mae_single = mean(cond(single_event, abs_error, .))

. bysort subject_id: egen mae_composite = mean(cond(!single_event, abs_error, .
> ))

. label variable mae_single "Mean absolute error of matching probabilities (sin
> gle events)"

. label variable mae_composite "Mean absolute error of matching probabilities (
> composite events)"

. 
. bysort subject_id: egen accurate_single = min(cond(single_event, exact_report
> , .))

. bysort subject_id: egen accurate_composite = min(cond(!single_event, exact_re
> port, .))

. bysort subject_id: egen accurate_all = min(exact_report)

. label variable accurate_single "Switch interval contains true p for all singl
> e events"

. label variable accurate_composite "Switch interval contains true p for all co
> mposite events"

. label variable accurate_all "Switch interval contains true p for all six even
> ts"

. 
. bysort subject_id: egen m_single_20 = max(cond(single_event & event_prob == 2
> 0, switch, .))

. bysort subject_id: egen m_single_30 = max(cond(single_event & event_prob == 3
> 0, switch, .))

. bysort subject_id: egen m_single_50 = max(cond(single_event & event_prob == 5
> 0, switch, .))

. bysort subject_id: egen m_composite_50 = max(cond(!single_event & event_prob 
> == 50, switch, .))

. bysort subject_id: egen m_composite_70 = max(cond(!single_event & event_prob 
> == 70, switch, .))

. bysort subject_id: egen m_composite_80 = max(cond(!single_event & event_prob 
> == 80, switch, .))

. 
. generate ranked_single = m_single_20 < m_single_30 & m_single_30 < m_single_5
> 0

. generate ranked_composite = m_composite_50 < m_composite_70 & m_composite_70 
> < m_composite_80

. label variable ranked_single "Single events ranked in the right order"

. label variable ranked_composite "Composite events ranked in the right order"

. 
. bysort subject_id: egen task_minutes = total(seconds_on_page / 60)

. label variable task_minutes "Time spent on tasks (minutes)"

. 
. keep if first_row == 1
(1,585 observations deleted)

. 
