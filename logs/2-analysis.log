. ******************************
. **# Figure 4: calibration plot
. ******************************
. 
. preserve

. 
. use `datapath'/vbb_data, clear

. sort subject_id task_order

. 
. tempname calibration_handle

. tempfile calibration

. postfile `calibration_handle' treatment single_event event_prob mean ci_lo ci
> _hi using `calibration'

. 
. set seed 5334

. levelsof event, local(events)
1 2 3 4 5 6

. foreach treat in 1 2 {
  2.         foreach e of local events {
  3.                 summarize event_prob if event == `e', meanonly
  4.                 local p = r(mean)
  5.                 local single = inlist(`e', 1, 2, 4)
  6.                 quietly bootstrap mean = r(mean), reps(`reps'): summarize 
> switch if treatment == `treat' & event == `e'
  7.                 matrix ci = e(ci_percentile)
  8.                 post `calibration_handle' (`treat') (`single') (`p') (_b[m
> ean]) (ci[1, 1]) (ci[2, 1])
  9.         }
 10. }

. postclose `calibration_handle'

. 
. use `calibration', clear

. generate x = event_prob - 1 if treatment == 1
(6 missing values generated)

. replace x = event_prob + 1 if treatment == 2
(6 real changes made)

. sort treatment single_event event_prob

. list treatment single_event event_prob mean ci_lo ci_hi, sepby(treatment sing
> le_event)

